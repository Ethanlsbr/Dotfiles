{
"layer": "top",
"position": "top",
"height": 40,
"spacing": 0,


"modules-left": [
    "custom/archicon",
    "hyprland/workspaces"
],

"modules-center": [
    "custom/spotify"
],

"modules-right": [
    "bluetooth",
    "group/volume",
    "battery",
    "network",
    "clock"
],


"group/misc": {
  "orientation": "inherit",
  "drawer": {
    "transition-duration": 500,
    "children-class": "misc-modules",
    "transition-top-to-bottom": false,
    "transition-left-to-right": false
  },
  "modules": [
    "custom/separator",
    "bluetooth"
  ]
},

"group/volume": {
  "orientation": "inherit",
  "drawer": {
    "transition-duration": 500,
    "transition-top-to-bottom": false,
    "transition-left-to-right": false
  },
  "modules": [
    "pulseaudio",
    "pulseaudio/slider"
  ]
},


 /*************************************************************************************************/


"custom/archicon": {
  "format": "   ",
  "tooltip": false,
  "on-click": "killall -9 rofi w|| rofi -show drun"
},

"custom/separator": {
  "format": "|",
  "tooltip": false
},

"pulseaudio/slider": {
  "min": 0,
  "max": 100,
  "orientation": "horizontal"
},

"custom/spotify": {
    "exec": "/usr/bin/python3 /home/ethan/.config/waybar/mediaplayer.py --player spotify",
    "format": " {}",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{}"
},

"custom/notification": {
  "tooltip": true,
  "format": " {icon}  ",
  "format-icons": {
    "notification": "",
    "none": "",
    "dnd-notification": "",
    "dnd-none": ""
  },
  "return-type": "json",
  "exec-if": "which swaync-client",
  "exec": "swaync-client -swb",
  "on-click": "swaync-client -t -sw",
  "on-click-middle": "swaync-client -C",
  "on-click-right": "swaync-client -d -sw",
  "escape": true
},

"clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{calendar}",
    "on-click": "swaync-client -t -sw",

    "calendar": {
        "mode"          : "month",
        "mode-mon-col"  : 3,
        "weeks-pos"     : "right",

        "format": {
            "months":   "<span color='#9D79D6'><b>{}</b></span>",
            "days":     "<span color='#A6ADC8'><b>{}</b></span>",
            "weeks":    "<span color='#7AA2F7'><b>W{}</b></span>",
            "weekdays": "<span color='#CBA6F7'><b>{}</b></span>",
            "today":    "<span color='#F38BA8'><b><u>{}</u></b></span>"
        }
    }
},

"battery": {
  "format": "{capacity}% {icon}",
  "format-icons": ["", "", "", "", ""],
  "format-charging": "{capacity}% ",
  "format-full": "{capacity}% {icon}",
  "interval": 30,
  "states": {
      "warning": 30,
      "critical": 15
  }
},

"backlight": {
    "format": " {percent}% {icon} ",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
},

"network": {
    "format-wifi": "  ",
    "on-click": "kitty nmtui",
    "format-ethernet": "wired",
    "tooltip-format": "{essid} {signalStrength}%",
    "format-disconnected": " "
  },

"pulseaudio": {
    "format": " {volume}% {icon} ",
    "format-muted": " <span size='15000'>󰝟</span> ",
    "format-icons": {
        // "headphone": "",
        // "hands-free": "",
        // "headset": "",
        // "phone": "",
        // "phone-muted": "",
        // "portable": "",
        // "car": "",
        "default": ["", "", ""]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "Volume: {volume}%",
    "scroll-step": 1
},

"bluetooth": {
    "format": "",
    "format-disabled": "",
    "format-connected": "{num_connections} ",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format-connected-battery": "{device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

"power-profiles-daemon": {
  "format": "{icon}",
  "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
  "tooltip": true,
  "format-icons": {
    "default": "  ",
    "performance": "  ",
    "balanced": "   ",
    "power-saver":"   "
  }
},

"wlr/taskbar": {
  "format": "{icon}",
  "rotate": 0,
  "icon-size": 24,
  "icon-theme": "Tela-circle-dracula",
      "spacing": 1,
  "tooltip-format": "{title}",
  "on-click": "activate",
  "on-click-middle": "close",
  "ignore-list": [
    "Alacritty"
  ],
  "app_ids-mapping": {
    "firefoxdeveloperedition": "firefox-developer-edition"
  }
},

"hyprland/workspaces": {
  "format": "{icon}",
  "rotate": 0,
  "icon-size": 18,
  "icon-theme": "Tela-circle-dracula",
      "spacing": 0,
  "tooltip-format": "{title}",
  "on-click": "activate",
  "on-click-middle": "close",
  "ignore-list": [
    "Alacritty"
  ],
  "app_ids-mapping": {
    "firefoxdeveloperedition": "firefox-developer-edition"
  }
}
}
