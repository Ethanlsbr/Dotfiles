@theme "~/.config/rofi/theme.rasi"

/* General Configuration */
configuration {
    modi: "drun,run,window";
    font:                "Firacode Nerd Font regular 12";
    font-weight:         600;
    show-icons:          true;
    display-drun:        " ";
    drun-display-format: "{name}";
    disable-history:     false;
    hide-scrollbar:      true;
    cycle:               false;
}